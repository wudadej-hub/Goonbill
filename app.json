{
  "expo": {
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.goonbill.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "com.android.vending.BILLING"
      ]
    },
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "ios": {
      "infoPlist": {
        "NSMicrophoneUsageDescription": "GoonBill uses the microphone so you can dictate invoice details on the job site."
      },
      "supportsTablet": true
    },
    "name": "GoonBill",
    "newArchEnabled": true,
    "orientation": "portrait",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-speech-recognition",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow GoonBill to access your photos for job documentation.",
          "cameraPermission": "Allow GoonBill to take before and after photos of your jobs."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ]
    ],
    "scheme": "goonbill",
    "slug": "goonbill",
    "userInterfaceStyle": "dark",
    "version": "1.1.0",
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "extra": {
      "eas": {
        "projectId": "4c0325e7-37df-45aa-af02-e9d3e750850b"
      }
    }
  }
}
